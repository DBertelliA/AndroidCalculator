<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="407dp"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:layout_width="411dp"
            android:layout_height="787dp"
            android:background="@color/negro"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:background="@color/verde"
                android:text="Calculadora"
                android:textColor="@color/blanco"
                android:textSize="25dp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="142dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/borde_externo"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="277dp"
                        android:layout_height="109dp"
                        android:background="@color/blanco"
                        android:gravity="center_vertical"
                        android:text="@string/textview" />

                    <Button
                        android:id="@+id/buttonDel"
                        android:layout_width="140dp"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:layout_weight="0"
                        android:backgroundTint="@color/rojo"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="Del" />


                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="410dp"
                android:layout_height="590dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="101dp"
                    android:background="@color/gris_oscuro"
                    android:orientation="horizontal">


                    <Button
                        android:id="@+id/buttonAC"
                        android:layout_width="wrap_content"
                        android:layout_height="101dp"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_option"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/ac"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/buttonCambioSigno"
                        android:layout_width="wrap_content"
                        android:layout_height="101dp"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_option"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/cambioSigno"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/buttonPorcentaje"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_option"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/procent"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/buttonDividir"
                        android:layout_width="wrap_content"
                        android:layout_height="101dp"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_uses"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/split"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="124dp"
                    android:background="@drawable/borde_externo"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonN7"
                        android:layout_width="wrap_content"
                        android:layout_height="124dp"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_n"
                        android:elevation="10dp"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/num7"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/buttonN8"
                        android:layout_width="wrap_content"
                        android:layout_height="124dp"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_n"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/num8"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/buttonN9"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_n"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/num9"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/buttonMulti"
                        android:layout_width="wrap_content"
                        android:layout_height="124dp"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_uses"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/multi"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="119dp"
                    android:background="@drawable/borde_externo3"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonN4"
                        android:layout_width="wrap_content"
                        android:layout_height="119dp"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_n"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/num4"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/buttonN5"
                        android:layout_width="wrap_content"
                        android:layout_height="119dp"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_n"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/num5"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/buttonN6"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_n"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/num6"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/buttonRest"
                        android:layout_width="wrap_content"
                        android:layout_height="119dp"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_uses"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/rest"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="116dp"
                    android:background="@drawable/borde_externo"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonN3"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_n"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/num3"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/buttonN2"
                        android:layout_width="wrap_content"
                        android:layout_height="116dp"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_n"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/num2"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/buttonN1"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_n"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/num1"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/buttonSum"
                        android:layout_width="wrap_content"
                        android:layout_height="116dp"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_uses"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/sum"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/borde_externo3"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonN0"
                        android:layout_width="wrap_content"
                        android:layout_height="119dp"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_n"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/num0"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/buttonDot"
                        android:layout_width="wrap_content"
                        android:layout_height="116dp"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_n"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/dot"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/buttonResult"
                        android:layout_width="wrap_content"
                        android:layout_height="114dp"
                        android:layout_weight="1"
                        android:background="@drawable/boton_style_uses"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:text="@string/result"
                        android:textColor="@color/negro"
                        app:backgroundTint="@null" />


                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>